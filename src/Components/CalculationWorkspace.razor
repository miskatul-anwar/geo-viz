@inject AppState State
@inject IJSRuntime JsRuntime
@implements IDisposable

<main class="calc-workspace-container" aria-label="Spatial Calculation Workspace">
    <header class="calc-tabs-header-bar" role="tablist" aria-label="Calculation Tabs">
        @foreach (var tab in State.Tabs)
        {
            var isCurrent = State.ActiveTabId == tab.Id;
            <div class="calc-tab-pill @(isCurrent ? "active" : "")"
                 role="tab"
                 aria-selected="@isCurrent"
                 tabindex="0"
                 @onclick="() => State.SwitchTab(tab.Id)">
                <LucideIcon Name="zap" Size="12" Color="@(isCurrent ? "var(--accent)" : "var(--text-secondary)")" />
                <span>@tab.Title</span>
                @if (State.Tabs.Count > 1)
                {
                    <button class="tab-close-btn"
                            @onclick="() => CloseTab(tab.Id)"
                            @onclick:stopPropagation="true"
                            title="Close tab @tab.Title"
                            aria-label="Close Tab @tab.Title">
                        <LucideIcon Name="x" Size="10" />
                    </button>
                }
            </div>
        }
        <button class="calc-add-tab-btn" @onclick="async () => await State.CreateTabAsync()" title="Add new calculation tab" aria-label="New Calculation Tab">
            <LucideIcon Name="plus" Size="10" />
            <span>New Tab</span>
        </button>
    </header>

    <section class="calc-workspace-body">
        <!-- 1. Tool selector -->
        <nav class="tool-selector-panel" aria-label="Spatial Geoprocessing Tools">
            @foreach (var category in ToolCatalog.Categories)
            {
                <h4 class="tool-category-title">@category.Name</h4>
                @foreach (var tool in category.Tools)
                {
                    var toolKey = tool.Key;
                    var selected = State.ActiveTab?.ActiveTool == toolKey;
                    <div class="tool-card-item @(selected ? "selected" : "")" @onclick='() => SetTool(toolKey)' role="button" tabindex="0">
                        <span class="tool-item-icon">
                            <LucideIcon Name="@tool.Icon" Size="14" Color="var(--accent)" />
                        </span>
                        <div class="tool-item-details">
                            <h4>@tool.Name</h4>
                            <p>@tool.Description</p>
                        </div>
                    </div>
                }
            }
        </nav>

        <!-- 2. Parameter configuration -->
        <article class="tool-config-panel" aria-label="Tool Parameters Configuration">
            @{
                var currentTool = State.ActiveTab is null ? null : ToolCatalog.ById.GetValueOrDefault(State.ActiveTab.ActiveTool);
            }
            @if (currentTool is not null && State.ActiveTab is not null)
            {
                <div class="config-header">
                    <h2>
                        <LucideIcon Name="@currentTool.Icon" Size="18" Color="var(--accent)" />
                        <span>@currentTool.Name</span>
                    </h2>
                    <p>@currentTool.LongDescription</p>
                </div>

                <div class="form-group">
                    <label for="primary-dataset-select">Input Layer:</label>
                    <select id="primary-dataset-select" class="form-control" @bind="_datasetId" disabled="@IsRasterTool(currentTool.Key)">
                        <option value="">-- Select a Layer --</option>
                        @foreach (var choice in LayerChoices)
                        {
                            <option value="@choice.DatasetId">@choice.Label</option>
                        }
                    </select>
                    @if (LayerChoices.Count == 0 && !IsRasterTool(currentTool.Key))
                    {
                        <span class="form-hint">Add layers in Map Studio first — tools run on the layers you have added.</span>
                    }
                </div>

                @if (currentTool.Key == "buffer")
                {
                    <div class="form-group">
                        <label for="buffer-distance-input">Buffer Distance (Meters):</label>
                        <div class="range-with-input">
                            <input type="range" min="100" max="500000" step="500" @bind="_bufferDistance" @bind:event="oninput" aria-label="Buffer Range" />
                            <input id="buffer-distance-input" type="number" class="form-control" @bind="_bufferDistance" />
                        </div>
                        <span class="form-hint">Radius: @((_bufferDistance / 1000.0).ToString("F1")) kilometers</span>
                    </div>
                }
                else if (currentTool.Key == "simplify")
                {
                    <div class="form-group">
                        <label for="simplify-tolerance-input">Simplification Tolerance (Degrees):</label>
                        <div class="range-with-input">
                            <input type="range" min="0.001" max="1.0" step="0.005" @bind="_tolerance" @bind:event="oninput" aria-label="Simplify Tolerance Range" />
                            <input id="simplify-tolerance-input" type="number" step="0.001" class="form-control" @bind="_tolerance" />
                        </div>
                    </div>
                }
                else if (currentTool.Key == "spatial_binning")
                {
                    <div class="form-group">
                        <label for="binning-grid-type">Binning Pattern:</label>
                        <select id="binning-grid-type" class="form-control" @bind="_gridType">
                            <option value="hexbin">Hexagonal Grid (Hexbin)</option>
                            <option value="square">Square Matrix Grid</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="bin-size-input">Cell Size (km):</label>
                        <input id="bin-size-input" type="number" step="1" min="1" max="1000" class="form-control" @bind="_cellSizeKm" />
                    </div>
                }
                else if (currentTool.Key == "spatial_query")
                {
                    <div class="form-group">
                        <label for="polygon-mask-select">Polygon Boundary Mask Dataset (Optional):</label>
                        <select id="polygon-mask-select" class="form-control" @bind="_maskDatasetId">
                            <option value="">-- None (Filter Attributes Only) --</option>
                            @foreach (var choice in PolygonChoices)
                            {
                                <option value="@choice.DatasetId">@choice.Label</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="attr-field-input">Property Field Name:</label>
                        <input id="attr-field-input" class="form-control" placeholder="e.g. population, magnitude" @bind="_filterField" />
                    </div>
                    <div style="display: grid; grid-template-columns: 110px 1fr; gap: var(--space-2);">
                        <div class="form-group">
                            <label for="attr-op-select">Operator:</label>
                            <select id="attr-op-select" class="form-control" @bind="_filterOp">
                                <option value=">">&gt;</option>
                                <option value=">=">&gt;=</option>
                                <option value="<">&lt;</option>
                                <option value="<=">&lt;=</option>
                                <option value="=">=</option>
                                <option value="!=">!=</option>
                                <option value="contains">contains</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="attr-val-input">Value:</label>
                            <input id="attr-val-input" class="form-control" placeholder="Comparison value..." @bind="_filterValue" />
                        </div>
                    </div>
                }
                else if (currentTool.Key == "random_points")
                {
                    <div class="form-group">
                        <label for="points-count-input">Number of Points:</label>
                        <input id="points-count-input" type="number" min="10" max="5000" class="form-control" @bind="_pointCount" />
                    </div>
                }
                else if (currentTool.Key == "overlay")
                {
                    <div class="form-group">
                        <label for="overlay-op-select">Overlay Operation:</label>
                        <select id="overlay-op-select" class="form-control" @bind="_overlayOp">
                            <option value="intersection">Intersection (A ∩ B)</option>
                            <option value="difference">Difference (A − B)</option>
                            <option value="symmetric_difference">Symmetric Difference (A △ B)</option>
                            <option value="clip">Clip (keep A inside B)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="overlay-boundary-select">Boundary / Overlay Dataset (B):</label>
                        <select id="overlay-boundary-select" class="form-control" @bind="_overlayDatasetId">
                            <option value="">-- Select Boundary Layer --</option>
                            @foreach (var choice in PolygonChoices)
                            {
                                <option value="@choice.DatasetId">@choice.Label</option>
                            }
                        </select>
                        @if (State.Datasets.Count == 0)
                        {
                            <span class="form-hint">Import a polygon dataset first.</span>
                        }
                    </div>
                }
                else if (currentTool.Key == "dissolve")
                {
                    <div class="form-group">
                        <label for="dissolve-field-input">Group By Field (optional):</label>
                        <input id="dissolve-field-input" class="form-control" placeholder="e.g. land_use — leave empty to merge everything"
                               value="@_groupField" @onchange="@(e => _groupField = e.Value?.ToString() ?? "")" />
                    </div>
                }
                else if (currentTool.Key == "spatial_join")
                {
                    <div class="form-group">
                        <label for="join-target-select">Polygon Target Dataset:</label>
                        <select id="join-target-select" class="form-control" @bind="_overlayDatasetId">
                            <option value="">-- Select Target Layer --</option>
                            @foreach (var choice in PolygonChoices)
                            {
                                <option value="@choice.DatasetId">@choice.Label</option>
                            }
                        </select>
                    </div>
                }
                else if (currentTool.Key is "morans_i" or "getis_ord" or "ols_regression" or "idw" or "kriging")
                {
                    <div class="form-group">
                        <label for="stat-field-select">@(currentTool.Key == "ols_regression" ? "Dependent Field:" : "Value Field:")</label>
                        <select id="stat-field-select" class="form-control" @bind="_statField">
                            <option value="">-- Select Field --</option>
                            @foreach (var field in InputSchemaFields)
                            {
                                <option value="@field">@field</option>
                            }
                        </select>
                    </div>
                    @if (currentTool.Key == "ols_regression")
                    {
                        <div class="form-group">
                            <label for="explanatory-input">Explanatory Fields (comma-separated):</label>
                            <input id="explanatory-input" class="form-control" placeholder="e.g. population, median_income" @bind="_explanatoryCsv" />
                        </div>
                    }
                    @if (currentTool.Key == "getis_ord")
                    {
                        <div class="form-group">
                            <label for="band-input">Distance Band (meters, empty = adaptive 3× NN):</label>
                            <input id="band-input" type="number" min="1" class="form-control" @bind="_bandMeters" />
                        </div>
                    }
                    @if (currentTool.Key is "idw" or "kriging")
                    {
                        <div class="form-group">
                            <label for="cell-size-input">Grid Cell Size (km):</label>
                            <input id="cell-size-input" type="number" min="0.1" step="1" class="form-control" @bind="_statCellSizeKm" />
                        </div>
                        <div class="form-group">
                            <label for="neighbors-input">Max Neighbors:</label>
                            <input id="neighbors-input" type="number" min="1" max="64" class="form-control" @bind="_statMaxNeighbors" />
                        </div>
                    }
                    @if (currentTool.Key == "idw")
                    {
                        <div class="form-group">
                            <label for="idw-power-input">Distance Power (exponent):</label>
                            <input id="idw-power-input" type="number" min="0.5" step="0.5" class="form-control" @bind="_idwPower" />
                        </div>
                    }
                    @if (currentTool.Key == "kriging")
                    {
                        <div class="form-group">
                            <label for="variogram-select">Variogram Model:</label>
                            <select id="variogram-select" class="form-control" @bind="_variogramModel">
                                <option value="spherical">Spherical</option>
                                <option value="exponential">Exponential</option>
                                <option value="gaussian">Gaussian</option>
                            </select>
                        </div>
                    }
                }
                else if (currentTool.Key is "shortest_path" or "service_area")
                {
                    <div class="form-group">
                        <label for="start-lng-input">Facility / Start Longitude:</label>
                        <input id="start-lng-input" type="number" step="0.0001" class="form-control" @bind="_startLng" />
                    </div>
                    <div class="form-group">
                        <label for="start-lat-input">Facility / Start Latitude:</label>
                        <input id="start-lat-input" type="number" step="0.0001" class="form-control" @bind="_startLat" />
                    </div>
                    @if (currentTool.Key == "shortest_path")
                    {
                        <div class="form-group">
                            <label for="end-lng-input">Destination Longitude:</label>
                            <input id="end-lng-input" type="number" step="0.0001" class="form-control" @bind="_endLng" />
                        </div>
                        <div class="form-group">
                            <label for="end-lat-input">Destination Latitude:</label>
                            <input id="end-lat-input" type="number" step="0.0001" class="form-control" @bind="_endLat" />
                        </div>
                        <div class="form-group">
                            <label for="algorithm-select">Algorithm:</label>
                            <select id="algorithm-select" class="form-control" @bind="_algorithm">
                                <option value="dijkstra">Dijkstra</option>
                                <option value="astar">A* (haversine heuristic)</option>
                            </select>
                        </div>
                    }
                    else
                    {
                        <div class="form-group">
                            <label for="max-distance-input">Max Network Distance (meters):</label>
                            <input id="max-distance-input" type="number" min="100" step="100" class="form-control" @bind="_maxDistanceM" />
                        </div>
                    }
                }
                else if (currentTool.Key == "od_matrix")
                {
                    <div class="form-group">
                        <label for="origins-select">Origins Layer:</label>
                        <select id="origins-select" class="form-control" @bind="_maskDatasetId">
                            <option value="">-- Select Origins Layer --</option>
                            @foreach (var choice in LayerChoices)
                            {
                                <option value="@choice.DatasetId">@choice.Label</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="destinations-select">Destinations Layer:</label>
                        <select id="destinations-select" class="form-control" @bind="_overlayDatasetId">
                            <option value="">-- Select Destinations Layer --</option>
                            @foreach (var choice in LayerChoices)
                            {
                                <option value="@choice.DatasetId">@choice.Label</option>
                            }
                        </select>
                    </div>
                }
                else if (currentTool.Key == "topology_check")
                {
                    <div class="form-group">
                        <label for="rule-select">Topology Rule:</label>
                        <select id="rule-select" class="form-control" @bind="_overlayOp">
                            <option value="must_not_overlap">Must Not Overlap (polygons)</option>
                            <option value="must_not_have_dangles">Must Not Have Dangles (lines)</option>
                            <option value="must_be_covered_by">Must Be Covered By (points/lines in polygons)</option>
                        </select>
                    </div>
                    @if (_overlayOp == "must_be_covered_by")
                    {
                        <div class="form-group">
                            <label for="cover-select">Covering Polygon Layer:</label>
                            <select id="cover-select" class="form-control" @bind="_maskDatasetId">
                                <option value="">-- Select Covering Layer --</option>
                                @foreach (var choice in PolygonChoices)
                                {
                                    <option value="@choice.DatasetId">@choice.Label</option>
                                }
                            </select>
                        </div>
                    }
                }
                else if (currentTool.Key == "join_csv")
                {
                    <div class="form-group">
                        <label for="key-field-input">Layer Key Field:</label>
                        <input id="key-field-input" class="form-control" placeholder="e.g. district_id" @bind="_keyField" />
                    </div>
                    <div class="form-group">
                        <label for="csv-key-input">CSV Key Column:</label>
                        <input id="csv-key-input" class="form-control" placeholder="e.g. id" @bind="_csvKey" />
                    </div>
                    <div class="form-group">
                        <label for="csv-text-input">CSV Content (header row + records):</label>
                        <textarea id="csv-text-input" class="form-control" rows="6" style="font-family: var(--font-mono); font-size: 10.5px;"
                                  placeholder="id,population&#10;D001,125000&#10;D002,98000" @bind="_csvText"></textarea>
                    </div>
                }
                else if (IsRasterTool(currentTool.Key))
                {
                    <div class="form-group">
                        <label for="raster-select">Raster Grid (.tif imported via Add Layer):</label>
                        <select id="raster-select" class="form-control" @bind="_rasterId">
                            <option value="">-- Select Raster --</option>
                            @foreach (var raster in State.Rasters)
                            {
                                <option value="@raster.Id">@raster.Name (@raster.Width×@raster.Height · @raster.CellSizeM m)</option>
                            }
                        </select>
                        @if (State.Rasters.Count == 0)
                        {
                            <span class="form-hint">Import an uncompressed single-band GeoTIFF via <strong>Add Layer</strong> to enable raster analysis.</span>
                        }
                    </div>
                    @if (currentTool.Key == "hillshade")
                    {
                        <div class="form-group">
                            <label for="azimuth-input">Light Azimuth (°):</label>
                            <input id="azimuth-input" type="number" min="0" max="360" class="form-control" @bind="_azimuth" />
                        </div>
                        <div class="form-group">
                            <label for="altitude-input">Light Altitude (°):</label>
                            <input id="altitude-input" type="number" min="0" max="90" class="form-control" @bind="_altitude" />
                        </div>
                    }
                    @if (currentTool.Key == "raster_calculator")
                    {
                        <div class="form-group">
                            <label for="expression-input">Expression (a = first raster, b = second):</label>
                            <input id="expression-input" class="form-control" style="font-family: var(--font-mono);" placeholder="e.g. a * 2 + 1  ·  sqrt(a) / max(a, b)" @bind="_expression" />
                        </div>
                        <div class="form-group">
                            <label for="raster-b-select">Second Raster (optional, for 'b'):</label>
                            <select id="raster-b-select" class="form-control" @bind="_secondRasterId">
                                <option value="">-- None --</option>
                                @foreach (var raster in State.Rasters)
                                {
                                    <option value="@raster.Id">@raster.Name</option>
                                }
                            </select>
                        </div>
                    }
                    @if (currentTool.Key == "zonal_stats")
                    {
                        <div class="form-group">
                            <label for="zones-select">Polygon Zones Layer:</label>
                            <select id="zones-select" class="form-control" @bind="_maskDatasetId">
                                <option value="">-- Select Zones Layer --</option>
                                @foreach (var choice in PolygonChoices)
                                {
                                    <option value="@choice.DatasetId">@choice.Label</option>
                                }
                            </select>
                        </div>
                    }
                    @if (currentTool.Key == "viewshed")
                    {
                        <div class="form-group">
                            <label for="obs-lng-input">Observer Longitude:</label>
                            <input id="obs-lng-input" type="number" step="0.0001" class="form-control" @bind="_observerLng" />
                        </div>
                        <div class="form-group">
                            <label for="obs-lat-input">Observer Latitude:</label>
                            <input id="obs-lat-input" type="number" step="0.0001" class="form-control" @bind="_observerLat" />
                        </div>
                        <div class="form-group">
                            <label for="obs-height-input">Observer Height (m):</label>
                            <input id="obs-height-input" type="number" min="0" step="1" class="form-control" @bind="_observerHeight" />
                        </div>
                    }
                }

                <div style="margin-top: auto; padding-top: var(--space-4); display: flex; gap: var(--space-2);">
                    <button class="btn btn-primary" style="flex: 1; padding: 8px 14px;" @onclick="Execute"
                            disabled="@(_isRunning || !CanExecute)" aria-label="Execute Calculation">
                        @if (_isRunning)
                        {
                            <span class="geoviz-spinner" style="width: 14px; height: 14px;"></span>
                            <span>Processing...</span>
                        }
                        else
                        {
                            <LucideIcon Name="play" Size="13" Color="#ffffff" />
                            <span>Run Analysis</span>
                        }
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(_runError))
                {
                    <div style="background-color: var(--color-danger-bg); border: 1px solid var(--color-danger); color: var(--color-danger); padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm); font-size: 11px; font-family: var(--font-mono); margin-top: var(--space-2);" role="alert">
                        @(_runError)
                    </div>
                }
            }
        </article>

        <!-- 3. Results -->
        <aside class="calc-results-panel" aria-label="Calculation Telemetry & Outputs">
            <header class="results-header">
                <span style="font-size: 11px; font-weight: 700; color: var(--text-primary);">Analysis Telemetry</span>
                @if (State.LastResult is { } r)
                {
                    <span class="brand-badge">@(r.ExecutionTimeMs)ms</span>
                }
            </header>

            @if (State.LastResult is { } result)
            {
                <div class="result-context-line" title="@_lastInputLabel">
                    <LucideIcon Name="layers" Size="11" Color="var(--text-muted)" />
                    <span><strong>@result.ToolName</strong> · input: @(_lastInputLabel ?? "unknown layer")</span>
                </div>
                <div class="metrics-grid">
                    <div class="metric-card">
                        <span class="metric-label">Output features</span>
                        <span class="metric-value">@result.FeatureCount</span>
                    </div>
                    <div class="metric-card">
                        <span class="metric-label">Runtime</span>
                        <span class="metric-value">@(result.ExecutionTimeMs) ms</span>
                    </div>
                </div>

                <MetricsSummary Summary="@result.SummaryMetrics" />

                <ResultPreview OutputGeojson="@result.OutputGeojson" />

                <div style="display: flex; flex-direction: column; gap: var(--space-2); margin-top: var(--space-2);">
                    <button class="btn btn-primary btn-sm" @onclick="AddToMap" disabled="@(_isAdding || _justAdded)" aria-label="Add Result to Map Layer">
                        @if (_justAdded)
                        {
                            <LucideIcon Name="layers" Size="12" Color="#ffffff" />
                            <span>Added to Map ✓</span>
                        }
                        else
                        {
                            <LucideIcon Name="map" Size="12" Color="#ffffff" />
                            <span>Add to Map Canvas</span>
                        }
                    </button>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-1);">
                        <button class="btn btn-secondary btn-sm" @onclick="DownloadResult" aria-label="Download Result GeoJSON">
                            <LucideIcon Name="download" Size="12" />
                            <span>.geojson</span>
                        </button>
                        <button class="btn btn-secondary btn-sm" @onclick="CopyResult" aria-label="Copy Result GeoJSON">
                            <LucideIcon Name="copy" Size="12" />
                            <span>Copy</span>
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div style="text-align: center; padding: 48px 12px; color: var(--text-muted);">
                    <div style="margin-bottom: 8px;">
                        <LucideIcon Name="activity" Size="28" Color="var(--text-muted)" />
                    </div>
                    <p style="font-weight: 600; color: var(--text-secondary);">No Output Yet</p>
                    <p style="font-size: 10px; margin-top: 4px;">Select tool parameters and click 'Run Analysis' to inspect results.</p>
                </div>
            }

            @if (State.RecentRuns.Count > 0)
            {
                <section style="margin-top: var(--space-3); border-top: 1px solid var(--border-subtle); padding-top: var(--space-2);" aria-label="Recent Analyses">
                    <h4 style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); margin: 0 0 var(--space-1) 0;">Recent Runs</h4>
                    <ul class="recent-runs-list">
                        @foreach (var run in State.RecentRuns.Take(8))
                        {
                            <li title="@run.CreatedAt">
                                <LucideIcon Name="check-circle-2" Size="11" Color="var(--color-success, #4ade80)" />
                                <span class="run-tool">@HumanizeTool(run.ToolName)</span>
                                <span class="run-meta">@FormatRunTime(run.CreatedAt) · @(run.ExecutionTimeMs)ms</span>
                            </li>
                        }
                    </ul>
                </section>
            }
        </aside>
    </section>
</main>

@code {
    /// <summary>Raised after a result layer lands on the map, so the shell can switch views.</summary>
    [Parameter] public EventCallback OnGoToMap { get; set; }

    private string _datasetId = string.Empty;
    private string _maskDatasetId = string.Empty;
    private string _overlayDatasetId = string.Empty;
    private string _overlayOp = "intersection";
    private string _groupField = "";
    private double _bufferDistance = 50000;
    private double _tolerance = 0.05;
    private string _gridType = "hexbin";
    private double _cellSizeKm = 100;
    private string _filterField = "";
    private string _filterOp = ">";
    private string _filterValue = "0";
    private int _pointCount = 100;

    // Spatial statistics / geostatistics drafts
    private string _statField = "";
    private string _explanatoryCsv = "";
    private double? _bandMeters;
    private double _statCellSizeKm = 20;
    private int _statMaxNeighbors = 12;
    private double _idwPower = 2;
    private string _variogramModel = "spherical";

    // Network drafts
    private double _startLng, _startLat, _endLng, _endLat;
    private string _algorithm = "dijkstra";
    private double _maxDistanceM = 10000;

    // Join drafts
    private string _keyField = "";
    private string _csvKey = "";
    private string _csvText = "";

    // Raster drafts
    private string _rasterId = "";
    private string _secondRasterId = "";
    private string _expression = "a * 1.0";
    private double _azimuth = 315;
    private double _altitude = 45;
    private double _observerLng, _observerLat;
    private double _observerHeight = 10;

    private bool _isRunning;
    private bool _isAdding;
    private bool _justAdded;
    private string? _runError;
    private string? _lastInputLabel;

    protected override void OnInitialized()
    {
        State.Changed += OnStateChanged;
        EnsureSelection();
    }

    public void Dispose() => State.Changed -= OnStateChanged;

    private void OnStateChanged()
    {
        EnsureSelection();
        if (State.LastResult != null && !ReferenceEquals(State.LastResult, _lastResult))
        {
            _lastResult = State.LastResult;
            _justAdded = false;
        }
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>Layer choices for every input selector: what the user sees on the map.</summary>
    private sealed record LayerChoice(string DatasetId, string Label, bool IsPolygon);

    private List<LayerChoice> LayerChoices =>
        Enumerable.Reverse(State.Layers)
            .Select(l => ToChoice(l))
            .Where(c => c is not null)
            .Select(c => c!)
            .ToList();

    private List<LayerChoice> PolygonChoices => LayerChoices.Where(c => c.IsPolygon).ToList();

    private LayerChoice? ToChoice(Layer l)
    {
        var ds = State.GetCachedDataset(l.DatasetId);
        if (ds is null) return null;
        var isPolygon = ds.GeomTypes.Any(t => t is "Polygon" or "MultiPolygon");
        return new LayerChoice(ds.Id, $"{l.Name} · {ds.FeatureCount:N0} feats", isPolygon);
    }

    /// <summary>Default to the active map layer; keep selection valid as layers change.</summary>
    private void EnsureSelection()
    {
        var valid = LayerChoices.Any(c => c.DatasetId == _datasetId);
        if (valid) return;

        _datasetId =
            (State.ActiveLayer is { } active ? LayerChoices.FirstOrDefault(c => c.DatasetId == active.DatasetId)?.DatasetId : null)
            ?? LayerChoices.FirstOrDefault()?.DatasetId
            ?? string.Empty;
    }

    private SpatialAnalysisResult? _lastResult;

    private async Task CloseTab(string id) => await State.CloseTabAsync(id);

    private async Task SetTool(string toolKey)
    {
        if (State.ActiveTab is { } tab && tab.ActiveTool != toolKey)
        {
            tab.ActiveTool = toolKey;
            await State.UpdateTabAsync(tab);
        }
    }

    private Dictionary<string, object?> BuildParameters(string tool) => tool switch
    {
        "buffer" => new() { ["distance_meters"] = _bufferDistance, ["steps"] = 16 },
        "convex_hull" => new() { ["per_feature"] = false },
        "bbox" => new() { ["per_feature"] = false },
        "simplify" => new() { ["tolerance_deg"] = _tolerance },
        "spatial_binning" => new() { ["grid_type"] = _gridType, ["cell_size_km"] = _cellSizeKm },
        "spatial_query" => new()
        {
            ["spatial_relation"] = "intersects",
            ["filter_dataset_id"] = string.IsNullOrEmpty(_maskDatasetId) ? null : _maskDatasetId,
            ["attribute_field"] = string.IsNullOrWhiteSpace(_filterField) ? null : _filterField.Trim(),
            ["attribute_op"] = _filterOp,
            ["attribute_val"] = string.IsNullOrWhiteSpace(_filterValue) ? null : _filterValue
        },
        "random_points" => new() { ["count"] = _pointCount, ["restrict_to_polygons"] = false },
        "overlay" => new()
        {
            ["operation"] = _overlayOp,
            ["filter_dataset_id"] = string.IsNullOrEmpty(_overlayDatasetId) ? null : _overlayDatasetId
        },
        "dissolve" => new() { ["group_field"] = string.IsNullOrWhiteSpace(_groupField) ? null : _groupField.Trim() },
        "spatial_join" => new()
        {
            ["filter_dataset_id"] = string.IsNullOrEmpty(_overlayDatasetId) ? null : _overlayDatasetId
        },
        // --- Spatial statistics ---
        "morans_i" => new() { ["attribute_field"] = _statField },
        "getis_ord" => new() { ["attribute_field"] = _statField, ["band_meters"] = _bandMeters },
        "ols_regression" => new() { ["attribute_field"] = _statField, ["explanatory_csv"] = _explanatoryCsv },
        "idw" => new()
        {
            ["attribute_field"] = _statField,
            ["idw_power"] = _idwPower,
            ["cell_size_km"] = _statCellSizeKm,
            ["max_neighbors"] = _statMaxNeighbors
        },
        "kriging" => new()
        {
            ["attribute_field"] = _statField,
            ["variogram_model"] = _variogramModel,
            ["cell_size_km"] = _statCellSizeKm,
            ["max_neighbors"] = _statMaxNeighbors
        },
        "mean_center" => new(),
        "median_center" => new(),
        "directional_mean" => new(),
        // --- Network ---
        "shortest_path" => new()
        {
            ["start_lng"] = _startLng, ["start_lat"] = _startLat,
            ["end_lng"] = _endLng, ["end_lat"] = _endLat,
            ["algorithm"] = _algorithm
        },
        "service_area" => new()
        {
            ["start_lng"] = _startLng, ["start_lat"] = _startLat,
            ["max_distance_m"] = _maxDistanceM
        },
        "od_matrix" => new()
        {
            ["filter_dataset_id"] = string.IsNullOrEmpty(_maskDatasetId) ? null : _maskDatasetId,
            ["target_dataset_id"] = string.IsNullOrEmpty(_overlayDatasetId) ? null : _overlayDatasetId
        },
        // --- Topology & joins ---
        "topology_check" => new()
        {
            ["operation"] = _overlayOp,
            ["filter_dataset_id"] = string.IsNullOrEmpty(_maskDatasetId) ? null : _maskDatasetId
        },
        "join_csv" => new()
        {
            ["key_field"] = _keyField.Trim(),
            ["csv_key"] = string.IsNullOrWhiteSpace(_csvKey) ? _keyField.Trim() : _csvKey.Trim(),
            ["csv_text"] = _csvText
        },
        // --- Raster (Spatial Analyst) ---
        "slope" => new() { ["raster_id"] = RasterArg },
        "hillshade" => new() { ["raster_id"] = RasterArg, ["azimuth"] = _azimuth, ["altitude"] = _altitude },
        "raster_calculator" => new()
        {
            ["raster_id"] = RasterArg,
            ["expression"] = _expression,
            ["second_raster_id"] = string.IsNullOrEmpty(_secondRasterId) ? null : _secondRasterId
        },
        "d8_flow" => new() { ["raster_id"] = RasterArg },
        "zonal_stats" => new()
        {
            ["raster_id"] = RasterArg,
            ["filter_dataset_id"] = string.IsNullOrEmpty(_maskDatasetId) ? null : _maskDatasetId
        },
        "viewshed" => new()
        {
            ["raster_id"] = RasterArg,
            ["observer_lng"] = _observerLng, ["observer_lat"] = _observerLat,
            ["observer_height_m"] = _observerHeight
        },
        _ => new()
    };

    private static bool IsRasterTool(string key) =>
        key is "slope" or "hillshade" or "raster_calculator" or "d8_flow" or "zonal_stats" or "viewshed";

    /// <summary>Raster tools need a raster; vector tools need a layer.</summary>
    private bool CanExecute =>
        !_isRunning && (IsRasterTool(State.ActiveTab?.ActiveTool ?? "")
            ? !string.IsNullOrEmpty(_rasterId)
            : !string.IsNullOrEmpty(_datasetId));

    /// <summary>Raster tools don't take a vector input; disable the layer selector for them.</summary>
    private string? RasterArg => string.IsNullOrEmpty(_rasterId) ? null : _rasterId;

    /// <summary>Numeric schema fields of the selected input layer (statistics candidates).</summary>
    private List<string> InputSchemaFields =>
        (State.GetCachedDataset(_datasetId)?.PropertiesSchema ?? new List<GeoViz.Models.FieldSchema>())
        .Where(f => f.FieldType is "number" or "integer" || double.TryParse(f.SampleValue, out _))
        .Select(f => f.Name)
        .ToList();

    private async Task Execute()
    {
        var tab = State.ActiveTab;
        if (tab is null || !CanExecute) return;

        _isRunning = true;
        _runError = null;
        try
        {
            var inputLabel = LayerChoices.FirstOrDefault(c => c.DatasetId == _datasetId)?.Label;
            _lastInputLabel = inputLabel is null ? "unknown layer" : inputLabel.Split('·')[0].Trim();
            await State.RunToolAsync(tab.ActiveTool, _datasetId, BuildParameters(tab.ActiveTool));
            try
            {
                await JsRuntime.InvokeVoidAsync("geoVizMotion.pulseElement", ".metrics-grid");
            }
            catch { /* best effort */ }
        }
        catch (Exception ex)
        {
            _runError = StripWrapper(ex.Message);
        }
        finally
        {
            _isRunning = false;
        }
    }

    private async Task AddToMap()
    {
        if (_isAdding || _justAdded) return;
        _isAdding = true;
        try
        {
            var layer = await State.AddResultAsLayerAsync();
            if (layer is not null)
            {
                _justAdded = true;
                await JsRuntime.InvokeVoidAsync("geoVizMap.zoomToLayer", layer.Id);
                if (OnGoToMap.HasDelegate)
                    await OnGoToMap.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _runError = StripWrapper(ex.Message);
        }
        finally
        {
            _isAdding = false;
        }
    }

    private async Task DownloadResult()
    {
        if (State.LastResult is not { } result || string.IsNullOrEmpty(result.OutputGeojson)) return;
        var file = $"{result.LayerName.Replace(' ', '_')}.geojson";
        await JsRuntime.InvokeVoidAsync("geoVizMap.downloadFile", file, result.OutputGeojson, "application/geo+json");
    }

    private async Task CopyResult()
    {
        if (State.LastResult is not { } result) return;
        await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", result.OutputGeojson);
    }

    /// <summary>Tauri wraps IPC errors; strip the redundant prefix for display.</summary>
    private static string StripWrapper(string message)
    {
        var marker = "Geoprocessing failed:";
        var idx = message.IndexOf(marker, StringComparison.Ordinal);
        return idx >= 0 ? message[(idx + marker.Length + 1)..] : message;
    }

    private static string HumanizeTool(string key) => ToolCatalog.ById.TryGetValue(key, out var info)
        ? info.Name
        : key.Replace('_', ' ');

    private static string FormatRunTime(string iso) => DateTime.TryParse(iso, out var t)
        ? (DateTime.UtcNow - t.ToUniversalTime()) switch
        {
            { TotalMinutes: < 1 } ts => $"{Math.Max(1, (int)ts.TotalSeconds)}s ago",
            { TotalHours: < 1 } ts => $"{(int)ts.TotalMinutes}m ago",
            { TotalDays: < 1 } ts => $"{(int)ts.TotalHours}h ago",
            var ts => $"{(int)ts.TotalDays}d ago"
        }
        : "—";
}
